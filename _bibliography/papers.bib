@article{huang2025impermeable,
  title       = {Asymptotic behavior toward viscous shock for impermeable wall and inflow problems of barotropic {Navier-Stokes} equations},
  author      = {Huang, X. and Kang, M.-J. and Kim, J. and Lee, H.},
  journal     = {J. Math. Anal. Appl.},
  volume      = {552},
  pages       = {129803},
  year        = {2025},
  abbr        = {JMAA},
  doi         = {10.1016/j.jmaa.2025.129803},
  arxiv       = {2405.03214},
  url         = {https://doi.org/10.1016/j.jmaa.2025.129803},
  publisher   = {Elsevier},
  abstract    = {We consider the compressible barotropic Navier–Stokes equations in a half-line and study the time-asymptotic behavior toward the outgoing viscous shock wave. Precisely, we consider the two boundary problems: impermeable wall and inflow problems, where the velocity at the boundary is given as a constant state. For both problems, when the asymptotic profile determined by the prescribed constant states at the boundary and far-fields is a viscous shock, we show that the solution asymptotically converges to the shifted viscous shock profiles uniformly in space, under the condition that initial perturbation is small enough in H¹ norm. Since our method works on the physical variables, we do not require that the anti-derivative variables belong to L² space as in the works of Matsumura–Mei and Huang–Matsumura–Shi. Moreover, for the inflow case, we remove the assumption γ ≤ 3 of Huang–Matsumura–Shi. Our results are based on the method of a-contraction with shifts, as the first extension of the method to the boundary value problems.},
  dimensions  = {true},
  bibtex_show = {true}
}

@article{han2025dispersive,
  title       = {Long-time behavior towards viscous-dispersive shock for {Navier-Stokes} equations of {Korteweg} type},
  author      = {Han, S. and Kang, M.-J. and Kim*, J. and Lee, H.},
  journal     = {J. Differential Equations},
  volume      = {426},
  pages       = {317--387},
  year        = {2025},
  abbr        = {JDE},
  doi         = {10.1016/j.jde.2025.01.070},
  arxiv       = {2402.09751},
  annotation  = {* Corresponding author},
  url         = {https://doi.org/10.1016/j.jde.2025.01.070},
  publisher   = {Elsevier},
  abstract    = {We consider the so-called Navier–Stokes–Korteweg (NSK) equations for the dynamics of compressible barotropic viscous fluids with internal capillarity. We handle the time-asymptotic stability in 1D of the viscous-dispersive shock wave that is a traveling wave solution to NSK as a viscous-dispersive counterpart of a Riemann shock. More precisely, we prove that when the prescribed far-field states of NSK are connected by a single Hugoniot curve, then solutions of NSK tend to the viscous-dispersive shock wave as time goes to infinity. To obtain the convergence, we extend the theory of a-contraction with shifts, used for the Navier–Stokes equations, to the NSK system. The main difficulty in analysis for NSK is due to the third-order derivative terms of the specific volume in the momentum equation. To resolve the problem, we introduce an auxiliary variable that is equivalent to the derivative of the specific volume.},
  dimensions  = {true},
  bibtex_show = {true},
  selected    = {true}
}

